{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/dol-p-localization-agent-toolkit/runtime-report.schema.json",
  "title": "Runtime localization smoke report",
  "type": "object",
  "required": ["schemaVersion", "kind", "family", "level", "runtimeQa", "scenarios"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string" },
    "kind": { "const": "localization-runtime-report" },
    "family": { "const": "localization" },
    "level": { "type": "string", "enum": ["smoke", "regression", "exhaustive"] },
    "target": {
      "type": "object",
      "properties": {
        "storySha256": { "type": "string" },
        "packageId": { "type": ["string", "null"] },
        "appVersion": { "type": ["string", "null"] },
        "modLoaderVersion": { "type": ["string", "null"] },
        "packagePath": { "type": ["string", "null"] }
      }
    },
    "device": {
      "type": ["object", "null"],
      "properties": {
        "model": { "type": ["string", "null"] },
        "serial": { "type": ["string", "null"] }
      }
    },
    "runtimeQa": { "type": "string", "enum": ["PASSED", "FAILED"] },
    "cleanup": { "type": "string", "enum": ["RESTORED", "FAILED", "SKIPPED"] },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tier", "ok", "failures"],
        "properties": {
          "id": { "type": "string" },
          "tier": { "type": "string", "enum": ["A", "C"] },
          "ok": { "type": "boolean" },
          "failures": { "type": "array", "items": { "type": "string" } },
          "require": { "type": "array", "items": { "type": "string" } },
          "expectTargetAny": {
            "type": "object",
            "properties": {
              "expected": { "type": "array", "items": { "type": "string" } },
              "found": { "type": "array", "items": { "type": "string" } },
              "missing": { "type": "array", "items": { "type": "string" } }
            }
          },
          "forbidSourceAny": {
            "type": "object",
            "properties": {
              "forbidden": { "type": "array", "items": { "type": "string" } },
              "present": { "type": "array", "items": { "type": "string" } }
            }
          },
          "diagnostics": {
            "type": "object",
            "properties": {
              "targetRatio": { "type": ["number", "null"] },
              "sourceRatio": { "type": ["number", "null"] },
              "pronounCount": { "type": ["number", "null"] },
              "renderedLength": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "timings": { "type": "object" }
  }
}
