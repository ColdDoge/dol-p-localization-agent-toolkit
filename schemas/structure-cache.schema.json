{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/dol-p-localization-agent-toolkit/structure-cache.schema.json",
  "title": "Structure cache manifest",
  "type": "object",
  "required": ["schemaVersion", "kind", "targetStory"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string" },
    "kind": { "const": "dol-p-structure-cache" },
    "generatedAt": { "type": "string" },
    "targetStory": {
      "type": "object",
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string" },
        "bytes": { "type": "number" },
        "passages": { "type": "number" },
        "ifid": { "type": ["string", "null"] },
        "format": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "version": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "pipeline": { "type": ["string", "null"] }
      }
    }
  }
}
